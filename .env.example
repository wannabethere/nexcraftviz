# nexcraftviz — copy to .env and fill in. Nothing here is required: without a
# key, propose()/commit() and every deterministic skill still work, and the
# server reports `hosted_mode: false` rather than failing later with a 401.
#
# These are the same variable names genieml uses, so one .env serves both.

# The key. Only needed when nexcraftviz owns the model (hosted mode, or
# `make eval-live`). An agent that brings its own model needs nothing here.
OPENAI_API_KEY=

# Model id. Defaults to gpt-5-mini, matching genieml.
OPENAI_MODEL=gpt-5-mini

# --- optional ---------------------------------------------------------------

# Override the bundled prompts without a release — point at a directory of
# .txt files named after the skills (viz.edit.txt, viz.place.txt, ...).
# NEXCRAFTVIZ_PROMPT_DIR=

# Restrict who may embed the widget. Defaults to "*", which is right for local
# development and wrong for a deployment.
# NEXCRAFTVIZ_ALLOW_ORIGINS=https://your-app.example.com
